# --- Modal (https://modal.com) -------------------------------------------
# Create with `modal token new` (stored in ~/.modal.toml) or set these:
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
# Name of the deployed serving app (see modal_app/serve.py)
EVAL_MODAL_APP=coherence-eval-serving

# --- Hugging Face (needed for gated models such as Llama / Gemma) ----------
HF_TOKEN=

# --- OpenRouter (https://openrouter.ai/keys) ---------------------------------
OPENROUTER_API_KEY=
# EVAL_OPENROUTER_CONCURRENCY=6      # parallel requests (free models default to 2)

# --- Platform ---------------------------------------------------------------
# The server has no login and can spend money on your accounts: keep it on localhost unless you know what you are doing.
# EVAL_HOST=127.0.0.1
EVAL_PORT=8000
EVAL_DATA_DIR=./data
# Force a provider: modal | openai | mock   (default: modal if credentials exist, else mock)
# EVAL_DEFAULT_PROVIDER=mock
